<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/player_background"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:surface_type="surface_view"
        app:use_controller="false" />

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:indeterminateTint="@color/player_accent"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="false"
        android:orientation="vertical">

        <!-- 顶部栏 -->
        <LinearLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_scrim_top"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_player_button"
                android:contentDescription="@string/back"
                android:src="@drawable/ic_chevron_left"
                app:tint="@color/player_control_text" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">

                <com.smbplayer.tv.widget.MarqueeTextView
                    android:id="@+id/tv_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/player_control_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.smbplayer.tv.widget.MarqueeTextView
                    android:id="@+id/tv_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/player_control_text"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_speed"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_pill_focused"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="1.00x"
                android:textColor="@color/on_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_delete"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_player_button"
                android:contentDescription="@string/player_delete_current"
                android:src="@drawable/ic_delete"
                app:tint="#FFFF8A80" />

            <ImageButton
                android:id="@+id/btn_playlist"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_player_button"
                android:contentDescription="@string/player_playlist"
                android:src="@drawable/ic_playlist_play"
                app:tint="@color/player_control_text" />
        </LinearLayout>

        <!-- 中间空白区：TV 上不参与焦点，仅供触摸屏设备点击隐藏控制条 -->
        <FrameLayout
            android:id="@+id/tap_area"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="false" />

        <!-- 底部控制栏 -->
        <LinearLayout
            android:id="@+id/bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_scrim_bottom"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/tv_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="4dp"
                android:textColor="#FFFF8A80"
                android:textSize="13sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_position"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="00:00"
                    android:textColor="@color/player_control_text"
                    android:textSize="13sp" />

                <!-- TV 遥控器快进快退由全局按键处理，进度条不抢焦点 -->
                <SeekBar
                    android:id="@+id/seek_progress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:focusable="false"
                    android:max="1000"
                    android:progressBackgroundTint="@color/player_seek_buffered"
                    android:progressTint="@color/player_seek_played"
                    android:splitTrack="false"
                    android:thumbTint="@color/player_seek_thumb" />

                <TextView
                    android:id="@+id/tv_duration"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="00:00"
                    android:textColor="@color/player_control_text"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 主播放控制行：上一个 / 后退 / 播放暂停 / 前进 / 下一个 -->
            <LinearLayout
                android:id="@+id/button_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingTop="6dp">

                <ImageButton
                    android:id="@+id/btn_prev_video"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_player_button"
                    android:contentDescription="@string/player_prev"
                    android:src="@drawable/ic_skip_previous"
                    app:tint="@color/player_control_text" />

                <ImageButton
                    android:id="@+id/btn_rew"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_player_button"
                    android:contentDescription="@string/btn_rew"
                    android:src="@drawable/ic_fast_rewind"
                    app:tint="@color/player_control_text" />

                <ImageButton
                    android:id="@+id/btn_play_pause"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="24dp"
                    android:background="@drawable/bg_play_circle"
                    android:contentDescription="@string/btn_play_pause"
                    android:padding="14dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_play"
                    app:tint="@color/player_control_text" />

                <ImageButton
                    android:id="@+id/btn_ffwd"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_player_button"
                    android:contentDescription="@string/btn_ffwd"
                    android:src="@drawable/ic_fast_forward"
                    app:tint="@color/player_control_text" />

                <ImageButton
                    android:id="@+id/btn_next_video"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_player_button"
                    android:contentDescription="@string/player_next"
                    android:src="@drawable/ic_skip_next"
                    app:tint="@color/player_control_text" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 按钮操作提示：放底部居中，避免挡住画面（控制条隐藏时下移） -->
    <TextView
        android:id="@+id/tv_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="168dp"
        android:background="@drawable/bg_hint_pill"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:textColor="@color/on_primary"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- 字幕叠加层：播前解析好的字幕按 currentPosition 渲染，控制条显示时上移避让 -->
    <TextView
        android:id="@+id/tv_subtitle_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="148dp"
        android:background="@null"
        android:shadowColor="#FF000000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="4"
        android:clickable="false"
        android:focusable="false"
        android:gravity="center"
        android:maxLines="3"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:textColor="@color/on_primary"
        android:textSize="18sp"
        android:visibility="gone" />

</FrameLayout>
