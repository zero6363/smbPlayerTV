<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 锁定深色：TV 全程深色界面，对话框（播放列表/服务器编辑/确认框）也必须
         深底浅字。不能用 DayNight——系统浅色模式会让对话框变浅底，而列表文字
         用的是固定的深色主题色值，会浅字浅底看不清。 -->
    <style name="Theme.SmbPlayer" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOutline">@color/outline</item>
        <item name="android:statusBarColor">@color/background</item>
    </style>

    <style name="Theme.SmbPlayer.Player" parent="Theme.SmbPlayer">
        <item name="android:windowBackground">@color/player_background</item>
        <item name="android:statusBarColor">@color/player_background</item>
        <item name="android:navigationBarColor">@color/player_background</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="Widget.SmbPlayer.ListItem" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_item_focused</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>
</resources>
